{
  "name": "24flight",
  "version": "0.1.0-beta",
  "description": "24Flight",
  "main": "app/src/server.js",
  "type": "module",
  "homepage": "https://github.com",
  "bugs": {
    "url": "https://github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com"
  },
  "license": "MIT",
  "author": "GreenvillSSnick & scythe_dev <support@24flight.org>",
  "contributors": [
    {
      "name": "GreenvillSSnick",
      "url": "https://github.com",
      "email": "green@24flight.org"
    },
    {
      "name": "scythe_dev",
      "url": "https://github.com",
      "email": "scythe@24flight.org"
    },
    {
      "name": "awdev",
      "url": "https://github.com",
      "email": "awdev@24flight.org"
    }
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:externals": "npm run build:autopilot && npm run build:apinputworker",
    "build:autopilot": "node scripts/build-autopilot.js",
    "build:apinputworker": "node scripts/build-apinputworker.js",
    "start": "npm run build:externals && npx electron .",
    "build": "npm run build:externals && npx electron-builder --win --mac",
    "build:all": "npm run build:externals && npx electron-builder --win --mac --linux",
    "build:linux": "npm run build:externals && npx electron-builder --linux",
    "build:mac": "npm run build:externals && npx electron-builder --mac",
    "build:win": "npm run build:externals && npx electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.24flight.desktop",
    "productName": "24Flight",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "nsis": {
      "warningsAsErrors": false,
      "oneClick": false,
      "include": "build/installer.nsh",
      "license": "LICENSE.md",
      "runAfterFinish": true,
      "allowElevation": true,
      "perMachine": true
    },
    "files": [
      "package.json",
      "app/**/*"
    ],
    "mac": {
      "icon": "build/icons/mac/icon.icns",
      "target": [
        "pkg"
      ],
      "sign": false,
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "install-deps/mac",
          "to": "install-deps/mac"
        },
        {
          "from": "autopilot/autopilot.exe",
          "to": "autopilot/autopilot.exe"
        },
        {
          "from": "autopilot/autopilot",
          "to": "autopilot/autopilot"
        },
        {
          "from": "apinputworker/InputWorker.jar",
          "to": "apinputworker/InputWorker.jar"
        }
      ]
    },
    "win": {
      "icon": "build/icons/win/icon.ico",
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "install-deps/win",
          "to": "install-deps/win"
        },
        {
          "from": "autopilot/autopilot.exe",
          "to": "autopilot/autopilot.exe"
        },
        {
          "from": "autopilot/autopilot",
          "to": "autopilot/autopilot"
        },
        {
          "from": "apinputworker/InputWorker.jar",
          "to": "apinputworker/InputWorker.jar"
        }
      ]
    },
    "linux": {
      "icon": "build/icons/linux/1024x1024.png",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman",
        "apk"
      ],
      "extraResources": [
        {
          "from": "install-deps/linux",
          "to": "install-deps/linux"
        },
        {
          "from": "autopilot/autopilot.exe",
          "to": "autopilot/autopilot.exe"
        },
        {
          "from": "autopilot/autopilot",
          "to": "autopilot/autopilot"
        },
        {
          "from": "apinputworker/InputWorker.jar",
          "to": "apinputworker/InputWorker.jar"
        }
      ]
    },
    "deb": {
      "depends": [
        "openjdk-26-jdk"
      ]
    },
    "rpm": {
      "depends": [
        "java-latest-openjdk-devel"
      ]
    },
    "pacman": {
      "depends": [
        "jdk-openjdk"
      ]
    },
    "apk": {
      "depends": [
        "openjdk26"
      ]
    }
  },
  "dependencies": {
    "discord-rpc-electron": "^4.0.2",
    "electron-overlay-window": "^4.1.0",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "sudo-prompt": "^9.2.1",
    "ws": "^8.19.0"
  }
}