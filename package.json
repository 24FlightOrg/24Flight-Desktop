{
  "name": "24flight",
  "version": "1.0.0",
  "description": "The PC client for 24Flight.",
  "main": "app/src/server.js",
  "type": "module",
  "homepage": "https://github.com/24FlightOrg/24FlightSystem#readme",
  "bugs": {
    "url": "https://github.com/24FlightOrg/24FlightSystem/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/24FlightOrg/24FlightSystem.git"
  },
  "license": "MIT",
  "author": "GreenvillSSnick & scythe_dev <support@24flight.org>",
  "contributors": [
    {
      "name": "GreenvillSSnick",
      "url": "https://github.com/GreenvillSSnick",
      "email": "green@24flight.org"
    },
    {
      "name": "scythe_dev",
      "url": "https://github.com/PilotJDK",
      "email": "scythe@24flight.org"
    },
    {
      "name": "awdev",
      "url": "https://github.com/awdev1",
      "email": "awdev@24flight.org"
    }
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:autopilot": "node scripts/build-autopilot.js",
    "build:win-e:autopilot": "powershell -NoProfile -Command \"if (Test-Path 'autopilot/build') { Remove-Item 'autopilot/build' -Recurse -Force -ErrorAction SilentlyContinue }\" && cmake -S autopilot -B autopilot/build -G \"Visual Studio 18 2026\" -A x64 && cmake --build autopilot/build --config Release",
    "start": "npm run build:autopilot && npx electron .",
    "build": "npm run build:autopilot && npx electron-builder --win --mac",
    "build:all": "npm run build:autopilot && npx electron-builder --win --mac --linux",
    "build:linux": "npm run build:autopilot && npx electron-builder --linux",
    "build:mac": "npm run build:autopilot && npx electron-builder --mac",
    "build:win": "npm run build:autopilot && npx electron-builder --win"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.24flight.desktop",
    "productName": "24Flight",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "mac": {
      "icon": "build/icons/mac/icon.icns",
      "target": [
        "dmg"
      ],
      "sign": false,
      "hardenedRuntime": false
    },
    "win": {
      "icon": "build/icons/win/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icons/linux/1024x1024.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "dmg": {
      "icon": "build/icons/mac/icon.icns",
      "iconSize": 128,
      "contents": [
        {
          "x": 130,
          "y": 220,
          "type": "file"
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "package.json",
      "app/**/*",
      "autopilot/autopilot.exe"
    ],
    "extraResources": [
      {
        "from": "autopilot/autopilot.exe",
        "to": "autopilot/autopilot.exe"
      },
      {
        "from": "autopilot/autopilot",
        "to": "autopilot/autopilot"
      }
    ]
  },
  "dependencies": {
    "discord-rpc-electron": "^4.0.2",
    "express": "^5.2.1",
    "ws": "^8.19.0"
  }
}
